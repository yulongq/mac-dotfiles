#!/bin/sh
set -eu
export GIT_NO_REPLACE_OBJECTS=1
git_local_env=$(git rev-parse --local-env-vars)

validate_commit() (
  snapshot=$(mktemp -d "${TMPDIR:-/tmp}/mac-dotfiles-pre-push.XXXXXX")
  trap 'rm -rf -- "$snapshot"' 0
  trap 'exit 1' HUP INT TERM
  git archive --format=tar --output="$snapshot/source.tar" "$1"
  mkdir "$snapshot/source"
  tar -xf "$snapshot/source.tar" -C "$snapshot/source"
  cd "$snapshot/source"
  # Keep Git commands in validation independent of the invoking repository.
  unset $git_local_env
  ./scripts/validate </dev/null
)

validated=' '
while read -r local_ref local_oid remote_ref remote_oid; do
  [ "$local_ref" != '(delete)' ] || continue
  object_type=$(git cat-file -t "$local_oid^{}")
  [ "$object_type" = commit ] || continue
  commit=$(git rev-parse --verify "$local_oid^{commit}")
  case "$validated" in
    *" $commit "*) continue ;;
  esac
  printf 'Validating %s (%s)\n' "$local_ref" "$commit" >&2
  validate_commit "$commit"
  validated="$validated$commit "
done
