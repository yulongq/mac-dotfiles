#!/usr/bin/env python3
"""Test each selected mode in a new CLI session using the same disposable home."""

import argparse
import json
import os
import secrets
import shlex
import signal
import subprocess
import sys
import tempfile
import threading
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
CALL = "call_probe"
PROMPT = "Run the requested local file-read check."


class ModelFixture(BaseHTTPRequestHandler):
    """Supply a single tool call and capture its actual result on loopback."""

    def log_message(self, *_):
        pass

    def responses_events(self, request):
        result = next((item["output"] for item in request["input"]
                       if item.get("type") == "function_call_output" and item["call_id"] == CALL), None)
        if result is None:
            item = {"type": "function_call", "call_id": CALL, "name": "exec_command",
                    "arguments": json.dumps({"cmd": self.server.command, "login": False})}
        else:
            item = {"type": "message", "role": "assistant", "id": "done",
                    "content": [{"type": "output_text", "text": "Finished."}]}
        return result, [
            {"type": "response.created", "response": {"id": "resp_probe"}},
            {"type": "response.output_item.done", "item": item},
            {"type": "response.completed", "response": {"id": "resp_probe"}},
        ]

    def messages_events(self, request):
        result = next((block["content"] for message in request["messages"]
                       if isinstance(message["content"], list) for block in message["content"]
                       if block.get("type") == "tool_result" and block["tool_use_id"] == CALL), None)
        if result is None:
            name = "Bash" if self.server.tool == "claude" else "bash"
            block = {"type": "tool_use", "id": CALL, "name": name, "input": {}}
            delta = {"type": "input_json_delta", "partial_json": json.dumps({"command": self.server.command})}
            stop = "tool_use"
        else:
            block = {"type": "text", "text": ""}
            delta = {"type": "text_delta", "text": "Finished."}
            stop = "end_turn"
        message = {"type": "message", "role": "assistant", "id": "msg_probe",
                   "model": request["model"], "content": [], "usage": {"input_tokens": 1, "output_tokens": 1}}
        return result, [
            {"type": "message_start", "message": message},
            {"type": "content_block_start", "index": 0, "content_block": block},
            {"type": "content_block_delta", "index": 0, "delta": delta},
            {"type": "content_block_stop", "index": 0},
            {"type": "message_delta", "delta": {"stop_reason": stop}, "usage": {"output_tokens": 1}},
            {"type": "message_stop"},
        ]

    def do_POST(self):
        request = json.loads(self.rfile.read(int(self.headers["Content-Length"])))
        path = self.path.partition("?")[0]
        if path.endswith("/responses"):
            result, events = self.responses_events(request)
        elif path.endswith("/messages"):
            result, events = self.messages_events(request)
        else:
            self.send_error(404)
            return
        if result is not None:
            self.server.result = json.dumps(result)
        body = "".join("event: " + event["type"] + "\ndata: " + json.dumps(event) + "\n\n"
                       for event in events).encode()
        self.send_response(200)
        self.send_header("Content-Type", "text/event-stream")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)


def invocation(tool, home, url, env, command):
    if tool == "claude":
        env.update(ANTHROPIC_BASE_URL=url, ANTHROPIC_API_KEY="loopback-fixture",
                   CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC="1")
        return ["claude", "-p", "--model", "sonnet", "--tools", "Bash",
                "--allowedTools", f"Bash({command})", "--", PROMPT]
    if tool == "pi":
        models = home / ".pi/agent/models.json"
        models.parent.mkdir(parents=True, exist_ok=True)
        provider = {"baseUrl": url, "api": "anthropic-messages", "apiKey": "loopback-fixture",
                    "models": [{"id": "probe"}]}
        models.write_text(json.dumps({"providers": {"fixture": provider}}))
        env["PI_OFFLINE"] = "1"
        return ["pi", "--provider", "fixture", "--model", "probe", "--tools", "bash", "-p", PROMPT]
    return ["codex", "exec", "--ephemeral", "--skip-git-repo-check", "-c", 'model_provider="fixture"',
            "-c", 'model_providers.fixture.name="fixture"', "-c", f'model_providers.fixture.base_url="{url}/v1"',
            "-c", 'model_providers.fixture.wire_api="responses"', "-m", "gpt-5.1-codex", PROMPT]


def probe(tool, mode, base):
    workspace = base / "workspace"
    home = workspace / "home"
    home.mkdir(parents=True, exist_ok=True)
    control = workspace / "control"
    marker = home / ".ssh/dotfiles-probe"
    marker.parent.mkdir(exist_ok=True)
    control_text, marker_text = secrets.token_hex(16), secrets.token_hex(16)
    control.write_text(control_text + "\n")
    marker.write_text(marker_text + "\n")
    path = str(Path(sys.executable).parent) + os.pathsep + os.environ["PATH"]
    env = {"HOME": str(home), "PATH": path, "SHELL": "/bin/bash",
           "LANG": "C", "TMPDIR": str(base), "NO_PROXY": "127.0.0.1,localhost",
           "HTTP_PROXY": "http://127.0.0.1:1", "HTTPS_PROXY": "http://127.0.0.1:1"}
    if tool == "pi":
        node = subprocess.check_output(["node", "-p", "process.execPath"], text=True).strip()
        env["PATH"] = str(Path(node).parent) + os.pathsep + env["PATH"]
    subprocess.run([str(ROOT / "scripts/deploy"), "apply", "--dest", str(home), f"{tool}={mode}"],
                   check=True, env=env, cwd=ROOT, stdin=subprocess.DEVNULL)
    command = shlex.join(["cat", str(control), str(marker)])
    with ThreadingHTTPServer(("127.0.0.1", 0), ModelFixture) as server:
        server.command = command
        server.tool = tool
        server.result = None
        url = f"http://127.0.0.1:{server.server_port}"
        args = invocation(tool, home, url, env, command)
        threading.Thread(target=server.serve_forever, daemon=True).start()
        try:
            with subprocess.Popen(args, env=env, cwd=workspace, start_new_session=True, stdin=subprocess.DEVNULL,
                                  stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True) as proc:
                try:
                    output, _ = proc.communicate(timeout=60)
                except (subprocess.TimeoutExpired, KeyboardInterrupt):
                    os.killpg(proc.pid, signal.SIGKILL)
                    proc.communicate()
                    raise
        finally:
            server.shutdown()
    if proc.returncode or server.result is None:
        raise RuntimeError(f"{tool} exited {proc.returncode} without a completed probe: {output[-1800:]}")
    result = server.result
    if control_text not in result:
        raise RuntimeError(f"control read did not run successfully: {result}")
    if marker_text in result:
        observed = "read"
    elif str(marker) in result and ("Operation not permitted" in result or "Permission denied" in result):
        observed = "denied"
    else:
        raise RuntimeError(f"marker read had an unexpected result: {result}")
    expected = "read" if mode == "host" else "denied"
    print(f"{tool} {mode}: workspace control read; synthetic .ssh marker {observed} (expected {expected})")
    if expected != observed:
        print(f"{tool}: {mode} is not effective for the tested shell operation. "
              "Check the active permission profile, managed requirements and enclosing sandbox.", file=sys.stderr)
    return observed == expected


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("tool", choices=("claude", "codex", "pi"))
    parser.add_argument("modes", metavar="MODE", choices=("host", "sandbox"), nargs="+")
    options = parser.parse_args()
    with tempfile.TemporaryDirectory(prefix="mac-dotfiles-session-") as tmp:
        try:
            passed = all(probe(options.tool, mode, Path(tmp).resolve()) for mode in options.modes)
        except (OSError, RuntimeError, subprocess.SubprocessError) as error:
            sys.exit(str(error))
        sys.exit(0 if passed else 1)
