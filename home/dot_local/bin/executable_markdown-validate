#!/bin/bash
set -euo pipefail
args=()
quiet=false
while (($#)); do
  case "$1" in
    --fix|-f) args+=(--fix) ;;
    --quiet|-q) quiet=true ;;
    --help|-h)
      printf '%s\n' 'Usage: markdown-validate [--fix|-f] [--quiet|-q]' 'Validates Markdown recursively in the current directory.'
      exit 0 ;;
    *) printf 'Unknown option: %s\n' "$1" >&2; exit 2 ;;
  esac
  shift
done
args+=(--config "$HOME/.config/markdownlint/.markdownlint-cli2.yaml" '**/*.md')
if "$quiet"; then
  markdownlint-cli2 "${args[@]}" >/dev/null
else
  markdownlint-cli2 "${args[@]}"
fi
