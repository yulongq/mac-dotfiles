export JAVA_HOME="$HOME/dep/graalvm-jdk-25.0.4.1+1.1/Contents/Home"
export MAVEN_HOME="$HOME/dep/apache-maven-3.9.16"
export ASDF_NODEJS_LEGACY_FILE_DYNAMIC_STRATEGY=latest_installed
export PNPM_HOME="$HOME/.local/share/pnpm"
export NPM_CONFIG_PREFIX="$HOME/.npm-global"
export npm_config_prefix="$NPM_CONFIG_PREFIX"

# Array assignment removes duplicates after path_helper or a local override assigns PATH.
typeset -U path fpath
path=(
  "$HOME/.local/bin"
  "$HOME/dep/golang/bin"
  "$MAVEN_HOME/bin"
  "$JAVA_HOME/bin"
  "$HOME/.kimi-code/bin"
  "$HOME/.grok/bin"
  "$PNPM_HOME/bin"
  "${ASDF_DATA_DIR:-$HOME/.asdf}/shims"
  "$NPM_CONFIG_PREFIX/bin"
  "$HOME/.bin"
  $path
  "$HOME/.lmstudio/bin"
)
fpath=("${ASDF_DATA_DIR:-$HOME/.asdf}/completions" "$HOME/.grok/completions/zsh" "$HOME/.docker/completions" $fpath)
export PATH
