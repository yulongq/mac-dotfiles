# To generate a new list of the default values:
# ghostty +show-config --default --docs > ~/ghostty-defaults.txt
#
# Online documentation:
# https://ghostty.org/docs/config/reference

theme = Snazzy Soft
# theme = Catppuccin Frappe

# Font settings
# List available fonts: ghostty +list-fonts
# font-family = Cascadia Code
font-family = Maple Mono Normal NF CN
font-size = 14
font-thicken = true
adjust-cell-height = 6

# Cursor settings
cursor-style = block
shell-integration-features = no-cursor

# Window settings
window-padding-x = 7
window-padding-y = 7
window-width = 140
window-height = 35
window-save-state = always
confirm-close-surface = false

# Split navigation
keybind = ctrl+shift+k=goto_split:up
keybind = ctrl+shift+j=goto_split:down
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+l=goto_split:right

# Split resizing
keybind = super+ctrl+down=resize_split:down,100
keybind = super+ctrl+left=resize_split:left,100
keybind = super+ctrl+up=resize_split:up,100
keybind = super+ctrl+right=resize_split:right,100

# Quick terminal
keybind = global:super+period=toggle_quick_terminal

# Opacity
background-opacity = 1
background-blur-radius = 20
