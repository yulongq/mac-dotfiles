{{- /* chezmoi:modify-template */ -}}
{{- $selection := includeTemplate "execution-mode" . | fromJson -}}
{{- $managed := includeTemplate "claude/settings.json" . | fromJson -}}
{{- $stdin := .chezmoi.stdin -}}
{{- $current := dict -}}
{{- if $stdin -}}{{- $current = fromJson $stdin -}}{{- end -}}
{{- if not (kindIs "map" $current) -}}{{- fail "expected a Claude Code settings object" -}}{{- end -}}
{{- $out := deepCopy $current -}}
{{- if $selection.baseline -}}
  {{- range $k, $v := omit $managed "sandbox" -}}{{- $out = set $out $k $v -}}{{- end -}}
  {{- $env := get $current "env" | default dict -}}
  {{- $out = set $out "env" (mergeOverwrite (deepCopy $env) (get $managed "env")) -}}
  {{- if not (hasKey $out "model") -}}{{- $out = set $out "model" "opus" -}}{{- end -}}
{{- end -}}
{{- $sandbox := deepCopy (get $current "sandbox" | default dict) -}}
{{- if or (eq $selection.mode "host") (and (eq $selection.mode "") (not (dig "enabled" true $sandbox))) -}}
  {{- $sandbox = set $sandbox "enabled" false -}}
{{- else -}}
  {{- $sandbox = mergeOverwrite $sandbox (get $managed "sandbox") -}}
  {{- $network := dig "sandbox" "network" (dict) $current -}}
  {{- if hasKey $network "allowUnixSockets" -}}
    {{- $sandbox = setValueAtPath (list "network" "allowUnixSockets") (get $network "allowUnixSockets") $sandbox -}}
  {{- end -}}
{{- end -}}
{{- $out = set $out "sandbox" $sandbox -}}
{{- if deepEqual $current $out -}}
  {{- $stdin -}}
{{- else -}}
  {{ toPrettyJson $out }}
{{- end -}}
